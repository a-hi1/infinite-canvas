# Cloud API example configuration.
# Do not commit real secrets.
#
# Docker Compose 插值：复制本文件为仓库根目录 `.env`（或导出同名环境变量）后
#   sudo docker compose -f docker-compose.local.yml up -d --build
# 本地直接跑 api 时也可：
#   set -a; source .env.api.example; set +a; DATA_DIR=./data/api node api/src/index.js

# Optional invite code. If set, register requires this code.
API_INVITE_CODE=

# Session cookie lifetime (seconds). Default 7 days.
API_SESSION_TTL_SEC=604800

# Set true when serving over HTTPS so Secure cookie flag is enabled.
API_COOKIE_SECURE=false

# Comma-separated browser origins allowed to call the API with credentials.
# Never use *. Credentialed cookies require exact origins.
# Example self-host: API_ALLOWED_ORIGINS=http://38.x.x.x:3001,http://127.0.0.1:3001
API_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Allow same-origin browser calls when Origin matches Host / X-Forwarded-Host
# (typical: open http://SERVER_IP:3001 and call /api via Nginx). Default true.
# Set false only if you want exclusive explicit whitelist control.
API_TRUST_PROXY_SAME_ORIGIN=true

# Upload / storage limits
API_MAX_BODY_BYTES=230686720
API_MAX_IMAGE_BYTES=20971520
API_MAX_VIDEO_BYTES=209715200
API_MAX_USER_BYTES=5368709120

# Server-side pull of imgen/vidgen URLs (ms). Video default in code is 90000 if unset.
# API_REMOTE_FETCH_TIMEOUT_MS=90000

# Max redirects when server pulls remote media (default 3, hard cap 5).
# API_REMOTE_FETCH_MAX_REDIRECTS=3

# Optional: let api / ai-proxy containers reach CDN via host proxy (Windows Docker).
# Browser VPN/proxy does NOT automatically apply inside containers.
# Example Clash / local HTTP proxy on host port 7890:
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
# NO_PROXY=localhost,127.0.0.1,api,ai-proxy,app
