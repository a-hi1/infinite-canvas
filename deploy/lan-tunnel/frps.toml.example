# frps（跑在公网服务器）示例配置。
# 复制为 frps.toml 后填入 token，勿提交真实 frps.toml。
#
# 安全：proxy 端口仅应映射到宿主机 127.0.0.1（见 docker-compose.frps.yml），
# 不对公网开放 18000，只给本机 Docker app 的 /lan-ai 使用。

bindPort = 7000

auth.method = "token"
# 与家里 frpc、服务器环境变量 FRP_TOKEN 保持一致（长随机串）
auth.token = "CHANGE_ME_TO_A_LONG_RANDOM_TOKEN"

# 可选：限制可被映射的远端端口，防止乱开端口
allowPorts = [
  { start = 18000, end = 18000 },
]
