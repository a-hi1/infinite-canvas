# AI Proxy example configuration.
# Copy this file to .env.proxy on the server and fill real values there.
# Do not commit .env.proxy or any real API keys.

# Upstream OpenAI-compatible or Gemini/Ark base URL.
# Examples:
# AI_PROXY_BASE_URL=https://www.codex2api.com
# AI_PROXY_BASE_URL=https://api.openai.com
# AI_PROXY_BASE_URL=https://generativelanguage.googleapis.com
AI_PROXY_BASE_URL=

# Real upstream API key. This stays on the server and is injected by ai-proxy.
AI_PROXY_API_KEY=

# Token that browser clients use as the app's API Key when Base URL points to ai-proxy.
# Use a long random value. If empty, the proxy is open to allowed origins and is unsafe for public use.
AI_PROXY_ACCESS_TOKEN=

# Comma-separated allowed browser origins. Keep this narrow for deployments.
# Local server example:
AI_PROXY_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Optional limits.
AI_PROXY_MAX_BODY_BYTES=83886080
AI_PROXY_TIMEOUT_MS=300000
AI_PROXY_RATE_LIMIT_WINDOW_MS=60000
AI_PROXY_RATE_LIMIT_MAX=120
